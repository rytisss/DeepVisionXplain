# example of file for storing private and user specific environment variables, like keys or system paths
# rename it to ".env" (excluded from version control by default)
# .env is loaded by train.py automatically
# hydra allows you to reference variables in .yaml configs with special syntax: ${oc.env:MY_VAR}

host_data_dir=./data
host_config_dir=./configs
host_log_dir=./logs
container_log_dir=/app/logs # <- leave this as default

# Weights & Biases API key. NEVER commit a real key here - this file only holds a placeholder.
WANDB_API_KEY=

# Weights & Biases project/entity to log runs to.
# Example:
#   WANDB_PROJECT=inobranda
#   WANDB_ENTITY=easyodm
WANDB_PROJECT=
WANDB_ENTITY=
